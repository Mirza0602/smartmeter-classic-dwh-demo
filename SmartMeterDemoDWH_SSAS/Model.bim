        ],
        "measures": [
          {
            "name": "Gesamtverbrauch kWh",
            "expression": " SUM(Fact_Consumption[EnergyKWH])\t",
            "formatString": "#,0.00"
          },
          {
            "name": "Anzahl Messungen",
            "expression": " COUNTROWS(Fact_Consumption)",
            "formatString": "#,0"
          },
          {
            "name": "Durchschnittsverbrauch je Messung",
            "expression": " DIVIDE([Gesamtverbrauch kWh], [Anzahl Messungen])",
            "formatString": "#,0.00"
          },
          {
            "name": "Anzahl Haushalte",
            "expression": " DISTINCTCOUNT(Fact_Consumption[HouseholdKey])",
            "formatString": "#,0"
          }
        ],
