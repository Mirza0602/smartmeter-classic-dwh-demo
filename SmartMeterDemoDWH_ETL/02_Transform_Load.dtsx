    <DTS:Executable
      DTS:refId="Package\SQL - Load Dim_Household"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Task &quot;SQL ausführen&quot;"
      DTS:DTSID="{7f26c1d1-7b15-4804-843d-b1eaf3ea5be2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Load Dim_Household"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E579655A-9ADD-417E-9523-C4BC5981B1F3}"
          SQLTask:SqlStatementSource="INSERT INTO dwh.Dim_Household (HouseholdId, TariffType, Acorn, AcornGrouped)&#xA;SELECT DISTINCT HouseholdId, TariffType, Acorn, AcornGrouped&#xA;FROM stg.HouseholdInfo;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Load Dim_Weather"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Task &quot;SQL ausführen&quot;"
      DTS:DTSID="{c9d0a28a-5d0b-49ac-a37e-cf7c61c04559}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Load Dim_Weather"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E579655A-9ADD-417E-9523-C4BC5981B1F3}"
          SQLTask:SqlStatementSource="INSERT INTO dwh.Dim_Weather (WeatherDateTime, Temperature, ApparentTemperature, Humidity, WindSpeed, PrecipType, Summary)&#xA;SELECT &#xA;    TRY_CAST(ReadingTime AS DATETIME2),&#xA;    TRY_CAST(Temperature AS DECIMAL(5,2)),&#xA;    TRY_CAST(ApparentTemperature AS DECIMAL(5,2)),&#xA;    TRY_CAST(Humidity AS DECIMAL(5,2)),&#xA;    TRY_CAST(WindSpeed AS DECIMAL(5,2)),&#xA;    PrecipType,&#xA;    Summary&#xA;FROM stg.WeatherHourly;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Load Fact_Consumption"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Task &quot;SQL ausführen&quot;"
      DTS:DTSID="{3a071299-7dcb-4d01-8239-70395c74f01a}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Load Fact_Consumption"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E579655A-9ADD-417E-9523-C4BC5981B1F3}"
          SQLTask:SqlStatementSource="INSERT INTO dwh.Fact_Consumption (HouseholdKey, DateKey, TimeKey, WeatherKey, TariffKey, EnergyKWH)&#xA;SELECT&#xA;    dh.HouseholdKey,&#xA;    CONVERT(INT, FORMAT(rt.ReadingDateTime, 'yyyyMMdd')),&#xA;    (DATEPART(HOUR, rt.ReadingDateTime) * 2) + (DATEPART(MINUTE, rt.ReadingDateTime) / 30),&#xA;    dw.WeatherKey,&#xA;    dt.TariffKey,&#xA;    CASE WHEN LTRIM(RTRIM(hc.EnergyKWH)) = 'Null' THEN NULL ELSE TRY_CAST(hc.EnergyKWH AS DECIMAL(10,4)) END&#xA;FROM stg.HalfHourlyConsumption hc&#xA;CROSS APPLY (SELECT TRY_CAST(hc.ReadingTime AS DATETIME2) AS ReadingDateTime) rt&#xA;INNER JOIN dwh.Dim_Household dh ON dh.HouseholdId = hc.HouseholdId&#xA;LEFT JOIN dwh.Dim_Weather dw ON dw.WeatherDateTime = DATEADD(SECOND, -DATEPART(SECOND, rt.ReadingDateTime), DATEADD(MINUTE, -DATEPART(MINUTE, rt.ReadingDateTime), rt.ReadingDateTime))&#xA;INNER JOIN dwh.Dim_Tariff dt ON dt.TariffType = dh.TariffType&#xA;WHERE rt.ReadingDateTime IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
